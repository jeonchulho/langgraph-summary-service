# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/summary_db

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here

# JWT
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application
APP_NAME=LangGraph Summary Service
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# Rate Limiting
RATE_LIMIT_PER_MINUTE=10

# Sentry (optional)
SENTRY_DSN=

# Cache
CACHE_TTL=3600

# API Keys
API_KEY_LENGTH=32
